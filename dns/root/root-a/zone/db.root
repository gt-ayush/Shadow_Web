$TTL 86400
@   IN  SOA a.root. admin.root. (
            2026080503 ; serial
            7200       ; refresh
            1800       ; retry
            604800     ; expire
            86400 )    ; minimum

@   IN  NS  a.root.
@   IN  NS  b.root.

a.root. IN A 10.89.10.2
b.root. IN A 10.89.10.4

; --- Top-Level Domain Delegations ---

; .x TLD
x.           IN  NS  ns1.dns.x.
x.           IN  NS  ns2.dns.x.
ns1.dns.x.   IN  A   10.89.10.20
ns2.dns.x.   IN  A   10.89.10.21

; .web TLD
web.         IN  NS  ns1.dns.web.
web.         IN  NS  ns2.dns.web.
ns1.dns.web. IN  A   10.89.10.30
ns2.dns.web. IN  A   10.89.10.31

; .shop TLD
shop.        IN  NS  ns1.dns.shop.
shop.        IN  NS  ns2.dns.shop.
ns1.dns.shop. IN A   10.89.10.40
ns2.dns.shop. IN A   10.89.10.41

; .cloud TLD
cloud.       IN NS   ns1.dns.cloud.
cloud.       IN NS   ns2.dns.cloud.
ns1.dns.cloud. IN A  10.89.10.50
ns2.dns.cloud. IN A  10.89.10.51

; .mail TLD
mail.        IN NS   ns1.dns.mail.
mail.        IN NS   ns2.dns.mail.
ns1.dns.mail. IN A   10.89.10.60
ns2.dns.mail. IN A   10.89.10.61

; .dev TLD
dev.         IN NS   ns1.dns.dev.
dev.         IN NS   ns2.dns.dev.
ns1.dns.dev.  IN A   10.89.10.70
ns2.dns.dev.  IN A   10.89.10.71
