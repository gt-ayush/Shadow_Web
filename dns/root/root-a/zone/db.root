$TTL 86400
@   IN  SOA a.root-servers.internal. hostmaster.shadow.web. (
        2026080301 ; Serial (YYYYMMDDNN)
        28800      ; Refresh (8 hours)
        7200       ; Retry (2 hours)
        604800     ; Expire (1 week)
        86400 )    ; Minimum TTL (1 day)

; Root Name Servers
@   IN  NS  a.root-servers.internal.
@   IN  NS  b.root-servers.internal.

; Glue Records for Root Name Servers (Assigned IPs on dns-net)
a.root-servers.internal. IN A 10.89.10.2
b.root-servers.internal. IN A 10.89.10.4

; =====================================================================
; TLD Delegations (.x, .web, .shop, .mail, .cloud, .dev)
; =====================================================================

; .x TLD Delegation
x.                  IN NS ns1.dns.x.
x.                  IN NS ns2.dns.x.
ns1.dns.x.          IN A  10.89.10.20
ns2.dns.x.          IN A  10.89.10.21

; .web TLD Delegation
web.                IN NS ns1.dns.web.
web.                IN NS ns2.dns.web.
ns1.dns.web.        IN A  10.89.10.30
ns2.dns.web.        IN A  10.89.10.31

; .shop TLD Delegation
shop.               IN NS ns1.dns.shop.
shop.               IN NS ns2.dns.shop.
ns1.dns.shop.       IN A  10.89.10.40
ns2.dns.shop.       IN A  10.89.10.41

; .mail TLD Delegation
mail.               IN NS ns1.dns.mail.
ns1.dns.mail.       IN A  10.89.10.50

; .cloud TLD Delegation
cloud.              IN NS ns1.dns.cloud.
ns1.dns.cloud.      IN A  10.89.10.60

; .dev TLD Delegation
dev.                IN NS ns1.dns.dev.
ns1.dns.dev.        IN A  10.89.10.70
