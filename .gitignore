# ==========================================
# 1. Logs & Archives (Keep folders, ignore contents)
# ==========================================
logs/*
!logs/.gitkeep
archives/*
!archives/.gitkeep

# Ignore root-level log/archive files if created accidentally
*.log
*.tar.gz
*.zip
*.sql

# ==========================================
# 2. Secrets & Credentials (CRITICAL)
# ==========================================
*.env
*.pem
*.key
*.p12
*.crt
id_rsa
id_ed25519
ansible_vault_pass.txt

# ==========================================
# 3. Ansible & System Temp Files
# ==========================================
*.retry
*.pyc
.cache/
__pycache__/

# ==========================================
# 4. OS & Editor Junk
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 5. Go Build Artifacts
# ==========================================
*.exe
*.out
*.test
bin/

# Vendor dependencies (use go.mod/go.sum instead)
registry/api/vendor/

# ==========================================
# 6. Podman/Docker Artifacts
# ==========================================
*.pid
*.sock
*.db
*.tar
*.img
*.lock
.container-logs/
container-data/
volumes/

# ==========================================
# 7. Backup & Generated Files
# ==========================================
*.bak
*.old
*.orig
*.tmp

# ==========================================
# 8. Node/Frontend (future-proofing)
# ==========================================
node_modules/
dist/
build/
